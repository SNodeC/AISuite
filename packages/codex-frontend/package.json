{
  "name": "@snodec/codex-frontend",
  "version": "1.0.0",
  "description": "Framework-neutral TypeScript frontend SDK for AISuite codex-bridge",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/generated.d.ts",
      "import": "./dist/protocol/generated.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && tsc -p tsconfig.type-tests.json && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "license": "LGPL-3.0-or-later OR MIT"
}
