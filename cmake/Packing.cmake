set(CPACK_PACKAGE_NAME "aisuite")
set(CPACK_PACKAGE_VENDOR "SNodeC")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_CONTACT "Volker Christian <me@vchrist.at>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY
    "Reusable C++ AI integrations based on SNode.C"
)
set(CPACK_VERBATIM_VARIABLES YES)
set(CPACK_STRIP_FILES YES)
set(CPACK_OUTPUT_FILE_PREFIX "${CMAKE_BINARY_DIR}/_packages")
set(CPACK_PACKAGING_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
set(CPACK_DEB_COMPONENT_INSTALL ON)
set(CPACK_RPM_COMPONENT_INSTALL ON)
set(CPACK_COMPONENTS_GROUPING ONE_PER_GROUP)
set(CPACK_COMPONENT_AISUITE_GROUP aisuite)
set(CPACK_COMPONENT_AISUITE-DEV_GROUP aisuite-dev)
set(CPACK_COMPONENT_AISUITEFRONTEND_GROUP aisuite-dev)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_GENERATE_SHLIBS ON)
set(CPACK_RPM_PACKAGE_LICENSE "MIT AND LGPL-3.0-or-later")
set(CPACK_RPM_PACKAGE_RELEASE 1)
set(CPACK_RPM_PACKAGE_RELEASE_DIST OFF)
set(CPACK_RPM_PACKAGE_RELOCATABLE OFF)
set(CPACK_DEBIAN_AISUITE_PACKAGE_NAME "aisuite")
set(CPACK_RPM_AISUITE_PACKAGE_NAME "aisuite")
set(CPACK_DEBIAN_AISUITE-DEV_PACKAGE_NAME "aisuite-dev")
set(CPACK_RPM_AISUITE-DEV_PACKAGE_NAME "aisuite-dev")
set(CPACK_SOURCE_IGNORE_FILES
    "/build[^/]*/;/checkouts/;/.git/;/.qtcreator/;/.local-credentials/;/secrets/;/stage[^/]*/;/package/;/packages/codex-frontend/(node_modules|dist)/;~$"
)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/PackageConfig.cmake")
get_cmake_property(CPACK_COMPONENTS_ALL COMPONENTS)
include(CPack)
