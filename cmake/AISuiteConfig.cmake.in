@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.11 CONFIG QUIET)
if(NOT TARGET nlohmann_json::nlohmann_json)
    find_path(AISUITE_NLOHMANN_JSON_INCLUDE_DIR nlohmann/json.hpp REQUIRED)
    add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED)
    set_target_properties(
        nlohmann_json::nlohmann_json
        PROPERTIES INTERFACE_INCLUDE_DIRECTORIES
                   "${AISUITE_NLOHMANN_JSON_INCLUDE_DIR}"
    )
endif()
set(_AISUITE_SNODEC_COMPONENTS
    core net-un-stream-legacy net-in-stream-legacy net-in6-stream-legacy
)
if("@AISUITE_ENABLE_CODEX_FRONTEND_WEBSOCKET@" STREQUAL "ON")
    list(APPEND _AISUITE_SNODEC_COMPONENTS websocket-server http-client
         websocket-client)
endif()
find_dependency(snodec 2.0 CONFIG COMPONENTS ${_AISUITE_SNODEC_COMPONENTS})
unset(_AISUITE_SNODEC_COMPONENTS)

include(
    "${CMAKE_CURRENT_LIST_DIR}/AISuiteTargets-v@AISUITE_CODEX_SOVERSION@.cmake"
)
check_required_components(AISuite)
